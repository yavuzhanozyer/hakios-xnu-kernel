# HakiOS fragment: the POCO X3 NFC (surya, SM7150-AC "Snapdragon 732G") -- what is true of this device and of no other.
#
# What it has of the common repository's and of its own:
#   the touch screen   a Novatek NT36672C on SPI (devices/surya/drivers/input/hakios.nt36672c.c), its firmware from the
#                      phone's /vendor/firmware (pull-firmware.sh -> fw-touch/ -> fw/novatek_ts_fw.bin in the image)
#   the buttons        the common driver (hakios.buttons.c) pointed at this phone's PMICs: power and volume down in the
#                      PM6150's power-on block (slave 0, 0x800, the undivided kind), volume up on GPIO2 of the PM6150L
#                      (slave 4, 0xc100): the addresses the ios-sweet port read these keys with on this phone
#   the display        UEFI's framebuffer (1080 x 2400 at 0x9c000000, Mu-Silicium's suryaPkg), drawn by the CPU
#   the battery        the level and the charger as UEFI's Qualcomm charger drivers say them (QcomChargerDxe, ChargerExDxe
#                      in suryaPkg), read by the loader and handed to the kernel (battery=1): read only, the charging
#                      itself is the firmware's; battguard (battery_stop=N) can end a run nobody watches before it is flat
# Every other phone driver is left out: their addresses, pins and rails are the POCO X5 Pro's.
CONFIG_DEVICE="surya"
CONFIG_HAKIOS_NT36672C=y
CONFIG_HAKIOS_TAS256X=y
CONFIG_HAKIOS_BUTTONS=y
CONFIG_TOUCHSCREEN=y
CONFIG_BUTTONS=y
CONFIG_BUTTONS_PON=0x008
CONFIG_BUTTONS_PON_GEN=2
CONFIG_BUTTONS_VOLUP=0x4c1
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_BATTGUARD=y
CONFIG_BATTERY=y
CONFIG_HAKIOS_ADSP=y
CONFIG_HAKIOS_SPEAKER=y
CONFIG_HAKIOS_SOUND=y
# CONFIG_HAKIOS_MIC is not set
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
# CONFIG_HAKIOS_TORCH is not set
CONFIG_HAKIOS_ADRENO=y
# CONFIG_HAKIOS_HAPTIC is not set
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
# CONFIG_HAKIOS_UFS is not set
# CONFIG_HAKIOS_WIFI is not set
# CONFIG_GPU is not set
#
# The speakers (3 November 2026: the right one heard): the audio DSP, this SoC's audio layout (adsp_sm7150=1), and what
# iOS plays through the right TAS2562 (sound=4). The left amplifier waits on the PM6150L's GPIO 8.
CONFIG_ADSP=y
CONFIG_SOUND=4
CONFIG_BOOTARGS="adsp_sm7150=1"
#
# The storage through the loader (ufs=2, common_defconfig's) is not yet seen on this phone: left out of its default line.
# CONFIG_UFS is not set
# CONFIG_WIFI is not set
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
