# HakiOS fragment: the Qualcomm SM7150 family (SM7150, SM7150-AB "730G", SM7150-AC "732G"; "sdmmagpie") -- what is true of the
# SoC, whatever phone it is in.
#
# What is the same as the SC7280's, and so needs nothing here: the GICv3 (distributor 0x17a00000, redistributors 0x17a60000),
# the PMIC arbiter (version 5: core 0xc440000, cnfg 0xc40a000, observer 0xe600000), the temperature sensors' two blocks
# (TSENS v2, readings at 0xc263000 and 0xc265000), the apps RSC (0x18220000), the cores numbered in MPIDR's second affinity
# field (0x000 to 0x700). The loader knows the SoC by UEFI's framebuffer at 0x9c000000 (xnuloader/loader.c, platform_sm7150)
# and gives the kernel cores 0-5 as the small ones.
#
# Eight cores, the kernel on core 7 (an A76): the ios-sweet port ran all eight on this SoC through PSCI (its patch 0078).
# CONFIG_CPUS=1 in a device's fragment, or cpus=1 on the command line, is the way back if a run stops while the cores start.
CONFIG_SOC="sm7150"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
#
# The processor clocks: the older frequency hardware of qcom-cpufreq-hw.c (OSM firmware, two groups at 0x18323000 and
# 0x18325800), not the SC7280's EPSS. The memory's bandwidth vote that comes with cpufreq=1 looks its bus clock managers up in
# this family's command database (AOP CMD DB at 0x85f20000 in suryaPkg's memory map); ddr=0 leaves the vote out.
CONFIG_CPUFREQ=y
CONFIG_CPUFREQ_OSM=y
CONFIG_SOC_CMD_DB=0x85f20000
#
# The chip's identity: SMEM at 0x86000000 (suryaPkg's memory map, 2 MB), item 137 as on every Qualcomm SoC of this age.
CONFIG_SOCINFO=y
CONFIG_SOC_SMEM=0x86000000
#
# The temperature sensors: the same blocks as the SC7280's, but the sensors are this SoC's: every one of the 32 by number
# (thermal_table=2), the hottest stopping the run at 105 degrees as on redwood.
CONFIG_THERMAL=y
CONFIG_THERMAL_TABLE=2
#
# The drivers of this SoC family. PMIC: the inventory of the PMICs' blocks, read only (the PM6150, PM6150L and their like),
# which the charger and the clock drivers to come start from.
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
CONFIG_PMIC=y
